@LIT_SITE_CFG_IN_HEADER@

import lit.util
import os

config.name = "selfcute"
config.selfcute_src_root = "@CMAKE_CURRENT_SOURCE_DIR@/.."
config.selfcute_obj_root = "@CMAKE_CURRENT_BINARY_DIR@/.."
config.lit_tools_dir = "@LLVM_TOOLS_DIR@"
config.selfcute_opt = os.path.join(
    config.selfcute_obj_root, "bin", "selfcute-opt@CMAKE_EXECUTABLE_SUFFIX@")
config.filecheck = os.path.join(
    config.lit_tools_dir, "FileCheck@CMAKE_EXECUTABLE_SUFFIX@")

lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
